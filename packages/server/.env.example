PORT=3001

# URL pública con la que se accede a la app (usada en los links de invitación)
# Ej: http://localhost:3001, https://midominio.com o http://IP_DEL_SERVIDOR
APP_URL=http://localhost:3001

# Database URL
#   - Con Docker Compose (dentro del contenedor): usar 'db' como host, así está en el .env de la raíz
#   - Para desarrollo local sin Docker: cambiar el host a 'localhost'
# Datos: postgresql://USUARIO:CONTRASEÑA@HOST:PUERTO/BASE_DE_DATOS?schema=public
DATABASE_URL="postgresql://postgres:postgres@db:5432/diagram_editor?schema=public"

# OpenAI API Key (opcional para desarrollo local, la inyecta Docker en producción)
OPENAI_API_KEY="sk-..."
