# ===== Variables de entorno para Docker Compose =====
# Copia este archivo como '.env' y cambia SOLO los valores que necesites.

# Credenciales de PostgreSQL (cámbialas antes de desplegar en producción)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=diagram_editor

# Puerto del servidor
PORT=3001

# URL pública con la que se accede a la app (usada en los links de invitación)
# Ej: http://localhost:3001, https://midominio.com o http://IP_DEL_SERVIDOR
APP_URL=http://localhost:3001

# OpenAI API Key (obligatoria para las funciones de IA)
OPENAI_API_KEY="sk-..."
